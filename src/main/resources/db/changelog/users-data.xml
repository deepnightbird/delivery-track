<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">


    <changeSet author="andrew" id="Populate-table-users">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0"><![CDATA[
                select count(*) from users
                ]]></sqlCheck>
        </preConditions>
        <sqlFile relativeToChangelogFile="true" path="users-data.sql" />
    </changeSet>

    <changeSet author="andrew" id="Populate-table-user_roles">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0"><![CDATA[
                select count(*) from user_roles
                ]]></sqlCheck>
        </preConditions>
        <sqlFile relativeToChangelogFile="true" path="user_roles-data.sql" />
    </changeSet>

</databaseChangeLog>